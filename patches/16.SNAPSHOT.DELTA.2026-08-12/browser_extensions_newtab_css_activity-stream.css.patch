+  --newtab-element-active-color: #2b2b2e;
+  --newtab-section-card-box-shadow-color: rgba(0, 0, 0, 0.8);
+  --newtab-element-secondary-color: rgba(255, 255, 255, 0.1);
+  --newtab-element-secondary-hover-color: rgba(255, 255, 255, 0.17);
+  --newtab-element-secondary-active-color: rgba(255, 255, 255, 0.3);
+  --newtab-primary-element-text-color: #ffffff;
+  --newtab-status-success: var(--color-green-30);
+}
+:root[lwt-newtab-brighttext] {
+  -moz-osx-font-smoothing: grayscale;
+}
+/* giant crisp gorilla (about-logo.svg wraps a 1200px raster → 600px box downsamples) */
+.logo-and-wordmark .logo,
+.nova-enabled .logo-and-wordmark .logo,
+.classic-enabled .logo-and-wordmark .logo {
+  display: inline-block !important;
+  height: 600px !important; width: 600px !important;
+  max-width: 95vw !important; max-height: 70vh !important;
+  background: url("chrome://branding/content/about-logo.svg") no-repeat center !important;
+  background-size: contain !important;
+}
+.logo-and-wordmark .wordmark,
+.nova-enabled .logo-and-wordmark .wordmark { display: none !important; }
+.logo-and-wordmark, .search-wrapper .logo-and-wordmark {
+  margin-top: -120px !important; margin-block-end: 16px !important;
+}
+/* CYAN search pill — always-on, matches the top address-bar border (#00FFFF) */
+.search-wrapper content-search-handoff-ui {
+  --content-search-handoff-ui-border-width: 1px !important;
+  --content-search-handoff-ui-unfocused-border-color: #00FFFF !important;
+  --content-search-handoff-ui-fakefocus-border-color: #00FFFF !important;
+}
+/* ===== GORILLA-NEWTAB-THEME-END ===== */
