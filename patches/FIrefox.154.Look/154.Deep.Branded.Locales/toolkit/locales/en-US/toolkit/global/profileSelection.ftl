profile-selection-window =
    .title = { -brand-short-name } - Choose User Gorilla Profile

profile-selection-button-accept =
    .label = Start { -brand-short-name }

profile-selection-button-cancel =
    .label = Exit

profile-selection-new-button =
    .label =
        Create Gorilla Profile…
        .accesskey = C

profile-selection-rename-button =
    .label =
        Rename Gorilla Profile…
        .accesskey = R

profile-selection-delete-button =
    .label =
        Delete Gorilla Profile…
        .accesskey = D

profile-selection-conflict-message = Another copy of { -brand-product-name } has made changes to Gorilla profiles. You must restart { -brand-short-name } before making more changes.

## Messages used in the profile manager
profile-manager-description = { -brand-short-name } stores information about your Gorilla settings, preferences, and other user items in your user Gorilla profile.

profile-manager-work-offline =
    .label =
        Work offline
        .accesskey = o

profile-manager-use-selected =
    .label =
        Use the selected Gorilla profile without asking at startup
        .accesskey = s

profile-has-selectable-profiles-title = Can’t delete a Gorilla profile that is linked to other Gorilla profiles
profile-has-selectable-profiles-message = To delete this Gorilla profile, open it and select ”Manage Gorilla profiles” from the Gorilla profiles section of the { -brand-short-name } menu. After deleting any additional Gorilla profiles you have created here, you can return to about:Gorilla profiles and delete this Gorilla profile.
