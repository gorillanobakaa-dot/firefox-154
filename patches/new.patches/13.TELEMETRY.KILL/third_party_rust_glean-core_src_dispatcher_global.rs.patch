 pub fn launch(task: impl FnOnce() + Send + 'static) {
+    // Gorilla: telemetry is disabled at the FOG layer (FOG::InitializeFOG is a
+    // no-op), so the dispatcher is never flushed. Metric-recording tasks would
+    // otherwise pile up in the pre-init buffer forever — costing ~0.84% parent
+    // CPU on the calling threads (Renderer/Compositor/WebRender/Socket) and
+    // slowly leaking memory holding closures. Drop them immediately in
+    // production. Test mode keeps full behavior so vendored tests still pass.
+    if !TESTING_MODE.load(Ordering::SeqCst) {
+        drop(task);
+        return;
+    }
