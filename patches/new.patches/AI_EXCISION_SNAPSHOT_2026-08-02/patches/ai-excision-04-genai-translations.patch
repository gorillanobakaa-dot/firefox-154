+/* ==========================================================================
+   GORILLA OVERRIDE 2026-08-01: FF154 REDESIGNED settings sidebar is a
+   moz-page-nav web component -- labels + icons live in shadow DOM where
+   document selectors cannot reach, but CSS custom properties inherit
+   through. The ghost-button text tokens (layered :host rules in
+   moz-page-nav.tokens.css) resolve near-black on our black page ->
+   invisible sidebar entries. Pin hard cyan on the nav subtree only
+   (page-wide --icon-color untouched). Selected keeps accent-primary.
+   Unlayered document rule on the host beats the widget @layer :host rule.
+   ========================================================================== */
+moz-page-nav {
+  --page-nav-button-text-color: #00FFFF;
+  --page-nav-button-text-color-hover: #00FFFF;
+  --page-nav-button-text-color-active: #00FFFF;
+  --icon-color: #00FFFF;
+}
+
+/* ==========================================================================
+   GORILLA OVERRIDE 2026-08-01 (round 3): main-content text of the redesigned
+   settings widgets (moz-checkbox / moz-toggle / setting-group ...) renders
+   black-on-dark -- the labels live in shadow DOM, so the line-56
+   label/description overrides never reach them. But moz-checkbox has ZERO
+   color rules of its own (pure color:inherit), so a document rule on the
+   HOST element flows straight through the shadow boundary.
+   THE TRICK (author: "remember the trick, because it worked"): shadow walls
+   stop SELECTORS, not inherited values or custom properties -- pin color +
+   tokens on the host element from document CSS and the inside follows.
+   ========================================================================== */
+body#preferences-body {
+  color: #00FFFF !important;
+  --text-color: #00FFFF;
+}
+setting-group, setting-control, setting-pane, moz-fieldset, moz-checkbox,
+moz-toggle, moz-radio-group, moz-radio, moz-select, moz-input-text,
+moz-input-search, moz-box-item, moz-box-group, moz-box-link,
+moz-message-bar, moz-promo, moz-support-link {
+  color: #00FFFF;
+  --text-color: #00FFFF;
 }
