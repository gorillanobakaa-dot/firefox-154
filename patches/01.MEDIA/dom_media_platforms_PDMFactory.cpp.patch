+// Returns true for video codecs that must be blocked in hardware-only mode.
+// Only H.264 is allowed (HW-decoded via VAAPI on IVB); VP8, VP9, AV1, HEVC
+// are blocked to prevent silent CPU fallback.
+static bool IsBlockedSoftwareOnlyVideoCodec(const nsACString& aMimeType) {
+  // GORILLA OVERRIDE 2026-08-11: gate on the master pref so the block can be
+  // lifted per-profile (whatsapp-desktop) without a rebuild. Default (pref=true)
+  // is unchanged: everything that is not H.264 is still blocked.
+  if (!StaticPrefs::media_gorilla_hardware_only_mode()) {
+    return false;
+  }
+  return !MP4Decoder::IsH264(aMimeType);
+}
 
